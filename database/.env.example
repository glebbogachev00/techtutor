# Copy to database/.env and fill in. Uses separate PG* vars (no url-encoding of
# special characters needed). Values are on Supabase → Connect → Connection string.
PGHOST=db.[PROJECT-REF].supabase.co
PGPORT=5432
PGUSER=postgres
PGPASSWORD='your-database-password'
PGDATABASE=postgres

# If the direct host hangs (IPv6-only), use the SESSION POOLER instead:
#   PGHOST=aws-0-<region>.pooler.supabase.com
#   PGUSER=postgres.[PROJECT-REF]
