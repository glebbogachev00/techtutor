{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/custom-courses",
      "destination": "/en/custom-courses",
      "permanent": false
    },
    {
      "source": "/in/resources",
      "destination": "/en/resources",
      "permanent": false
    },
    {
      "source": "/us/resources",
      "destination": "/en/resources",
      "permanent": false
    },
    {
      "source": "/in/:slug(.*-explained)",
      "destination": "/en/:slug",
      "permanent": false
    },
    {
      "source": "/us/:slug(.*-explained)",
      "destination": "/en/:slug",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
